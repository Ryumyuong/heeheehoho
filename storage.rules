rules_version = '2';

// heeheehoho Firebase Storage 보안 규칙
// - 로그인 없이 쓰는 앱이라, 커뮤니티 사진 경로만 열고 나머지는 기본 차단.
// - Firebase 콘솔 → Storage → 규칙 탭에 붙여넣고 게시.

service firebase.storage {
  match /b/{bucket}/o {

    // 커뮤니티 사진 (community/…)
    //  - read: 누구나 보기(피드 이미지 공개)
    //  - create/update: 10MB 이하 이미지 파일만 업로드 허용
    //  - delete: 게시물 삭제 시 사진도 같이 지우기 위해 허용
    //
    // ⚠️ Firestore 규칙과 같은 한계 — 로그인이 없어서 요청자를 확인할 수 없다.
    //    익명 로그인을 붙이면 경로에 uid를 넣어 본인 것만 지우게 조일 수 있다.
    match /community/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.resource != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }

    // 그 외 모든 경로는 자동 차단(default deny).
  }
}
