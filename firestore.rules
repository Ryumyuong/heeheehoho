rules_version = '2';

// heeheehoho Firestore 보안 규칙
//
// 앱에 로그인 화면은 없지만 시작할 때 **익명 로그인**을 한다(main.dart).
// 기기마다 uid 가 하나 생기고, 글·댓글·이웃에 그 uid 를 함께 저장하므로
// "본인 것만 쓰기/지우기"를 서버가 직접 검증할 수 있다.
//
// Firebase 콘솔 → Firestore Database → 규칙 탭에 그대로 붙여넣고 게시.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 주인(사람) 닉네임 예약 — 중복 방지용. 강아지 이름은 중복 허용이라 안 온다.
    match /owner_nicknames/{name} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly(['name', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 1
                    && request.resource.data.name.size() <= 20;
      allow update, delete: if false;
    }

    // 가입자 명부. 문서 ID = 그 사람의 uid.
    //  - read: 이웃 목록의 "최근 가입"·닉네임 검색
    //  - write: 본인 문서만
    match /users/{uid} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == uid;

      // 내가 추가한 이웃. 내 문서 아래에만 쌓이므로 남이 못 건드린다.
      match /neighbors/{otherUid} {
        allow read: if true;
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    // 커뮤니티 밸런스 게임 투표 집계
    match /community/{docId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['votesA', 'votesB'])
                            && request.resource.data.votesA is int
                            && request.resource.data.votesB is int
                            && request.resource.data.votesA >= 0
                            && request.resource.data.votesB >= 0;
      allow delete: if false;
    }

    // 커뮤니티 게시물 (사진은 Storage, 메타데이터는 여기)
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.imageUrl is string
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.likes is int
                    && request.resource.data.shares is int;
      allow update: if false;
      // 본인 글만 삭제. 예전에 uid 없이 올라간 글은 지울 수 없다.
      allow delete: if signedIn()
                    && resource.data.authorUid == request.auth.uid;

      // 댓글
      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
                      && request.resource.data.authorUid == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() >= 1
                      && request.resource.data.text.size() <= 500
                      && request.resource.data.createdAt is timestamp;
        allow update: if false;
        allow delete: if signedIn()
                      && resource.data.authorUid == request.auth.uid;
      }
    }

    // 위에 명시되지 않은 모든 경로는 자동으로 차단된다(default deny).
  }
}
